[0.785, "o", "\u001b[?2004l\r\r\n"]
[0.153, "o", "\r\nДоступные команды:\r\n\r\nУправление таблицами:\r\n  create_table <имя> <столбец:тип> ...\r\n  list_tables\r\n  drop_table <имя>\r\n  info <имя>\r\n\r\nРабота с записями:\r\n  insert into <таблица> values (<значения>)\r\n  select from <таблица>\r\n  select from <таблица> where <условие>\r\n  update <таблица> set <условия> where <условие>\r\n  delete from <таблица> where <условие>\r\n\r\nДополнительные команды:\r\n  help\r\n  exit\r\n\r\n\r\n>>> Введите команду: "]
[5.188, "o", "create_table users name:str age:int"]
[0.269, "o", "\r\n"]
[0.007, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int\r\n"]
[0.001, "o", "\r\n>>> Введите команду: "]
[5.241, "o", "insert into users values (\"Anna\", 25)"]
[0.501, "o", "\r\n"]
[0.012, "o", "Функция insert выполнилась за 0.001 секунд\r\nЗапись успешно добавлена. ID: 1\r\n"]
[0.000, "o", "\r\n>>> Введите команду: "]
[5.823, "o", "insert into users values (\"Sergei\", 28)"]
[0.551, "o", "\r\n"]
[0.002, "o", "Функция insert выполнилась за 0.001 секунд\r\nЗапись успешно добавлена. ID: 2\r\n"]
[0.000, "o", "\r\n>>> Введите команду: "]
[4.932, "o", "select from users"]
[0.579, "o", "\r\n"]
[0.007, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[0.089, "o", "+----+--------+-----+\r\n| ID |  name  | age |\r\n+----+--------+-----+\r\n| 1  |  Anna  |  25 |\r\n| 2  | Sergei |  28 |\r\n+----+--------+-----+\r\n"]
[0.000, "o", "\r\n>>> Введите команду: "]
[4.577, "o", "select from users where age = 28"]
