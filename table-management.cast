[0.712, "o", "\r\n***Процесс работы с таблицей***\r\ncreate_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\nlist_tables - показать список таблиц\r\ndrop_table <имя_таблицы> - удалить таблицу\r\nhelp - справочная информация\r\nexit - выход из программы\r\n\r\nВведите команду: "]
[5.820, "o", "create_table demo_users name:str age:int"]
[0.357, "o", "\r\n"]
[0.005, "o", "Таблица \"demo_users\" успешно создана со столбцами: ID:int, name:str, age:int\r\n"]
[0.001, "o", "Введите команду: "]
[4.294, "o", "list_tables"]
[0.670, "o", "\r\n"]
[0.001, "o", "- demo_users\r\n"]
[0.000, "o", "Введите команду: "]
[4.619, "o", "drop_table demo_users"]
[0.725, "o", "\r\n"]
[0.003, "o", "Таблица \"demo_users\" успешно удалена.\r\n"]
[0.001, "o", "Введите команду: "]
[3.867, "o", "list_tables"]
[0.362, "o", "\r\n"]
[0.002, "o", "Таблиц пока нет.\r\n"]
