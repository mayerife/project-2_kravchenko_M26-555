[0.460, "o", "\u001b[?2004l\r\r\n"]
[0.125, "o", "\r\n***Операции с данными***\r\n\r\nФункции:\r\ninsert into <таблица> values (<значения>) - создать запись.\r\nselect from <таблица> - прочитать все записи.\r\nselect from <таблица> where <столбец> = <значение> - поиск записей.\r\nupdate <таблица> set <столбец> = <значение> where <столбец> = <значение> - обновить записи.\r\ndelete from <таблица> where <столбец> = <значение> - удалить записи.\r\ninfo <таблица> - информация о таблице.\r\ncreate_table <таблица> <столбец:тип> ... - создать таблицу.\r\nlist_tables - показать список таблиц.\r\ndrop_table <таблица> - удалить таблицу.\r\nhelp - справочная информация.\r\nexit - выход из программы.\r\n\r\n\r\n>>> Введите команду: "]
[4.932, "o", "create_table users name:str age:int active:bool"]
[0.487, "o", "\r\n"]
[0.007, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, active:bool\r\n\r\n>>> Введите команду: "]
[3.513, "o", "list_tables"]
[0.314, "o", "\r\n"]
[0.004, "o", "- users\r\n"]
[0.000, "o", "\r\n>>> Введите команду: "]
[4.953, "o", "info users"]
[0.474, "o", "\r\n"]
[0.006, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, active:bool\r\nКоличество записей: 0\r\n\r\n>>> Введите команду: "]
[5.375, "o", "insert into users values (\"Sergei\", 28, true)"]
[0.386, "o", "\r\n"]
[0.007, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[0.000, "o", "\r\n>>> Введите команду: "]
[4.536, "o", "insert into users values (\"Anna\", 25, false)"]
[0.348, "o", "\r\n"]
[0.007, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[0.000, "o", "\r\n>>> Введите команду: "]
[4.686, "o", "insert into users values (\"Maria\", 30, true)"]
[0.547, "o", "\r\n"]
[0.005, "o", "Запись с ID=3 успешно добавлена в таблицу \"users\".\r\n\r\n>>> Введите команду: "]
[4.915, "o", "select from users"]
[0.364, "o", "\r\n"]
[0.683, "o", "+----+--------+-----+--------+\r\n| ID |  name  | age | active |\r\n+----+--------+-----+--------+\r\n| 1  | Sergei |  28 |  True  |\r\n| 2  |  Anna  |  25 | False  |\r\n| 3  | Maria  |  30 |  True  |\r\n+----+--------+-----+--------+\r\n\r\n>>> Введите команду: "]
[5.408, "o", "select from users where age = 28"]
[0.335, "o", "\r\n"]
[0.007, "o", "+----+--------+-----+--------+\r\n| ID |  name  | age | active |\r\n+----+--------+-----+--------+\r\n| 1  | Sergei |  28 |  True  |\r\n+----+--------+-----+--------+\r\n\r\n>>> Введите команду: "]
[4.981, "o", "update users set age = 29 where name = \"Sergei\""]
[0.464, "o", "\r\n"]
[0.005, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n\r\n>>> Введите команду: "]
